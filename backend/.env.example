# Backend configuration. Copy to backend/.env and fill in. Never commit .env.
PORT=8787

# DeepSeek API key (required for LLM enrichment). Leave blank to run deterministic-only.
DEEPSEEK_API_KEY=

# Brave Search API key (required for automatic company-website discovery).
BRAVE_SEARCH_API_KEY=

# Path to the local SQLite/JSON data store.
DATABASE_PATH=./data/enrichment.sqlite

# Comma-separated Chrome extension IDs allowed via CORS (e.g. abcdefghijklmnop...).
ALLOWED_EXTENSION_IDS=

# Local installation token shared with the extension (Authorization: Bearer <token>).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INSTALL_TOKEN=

# Retention window for non-LinkedIn website/imported data (days).
DATA_RETENTION_DAYS=30

# DeepSeek model + reasoning effort (defaults shown).
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=max
DEEPSEEK_BASE_URL=https://api.deepseek.com
