{
  "manifest_version": 3,
  "name": "Prospect Import & Grounded Avatar Tool",
  "version": "1.0.0",
  "description": "Import professional contacts from user-visible pages, filter and deduplicate them, research companies, and build evidence-grounded prospect avatars. Not affiliated with or endorsed by LinkedIn, Waalaxy, or Lemlist.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Prospect Import & Grounded Avatar Tool",
    "default_popup": "popup/popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content/bootstrap.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/*.js",
        "content/adapters/*.js",
        "content/extractors/*.js",
        "content/selectors/*.js",
        "selector/*.js",
        "utils/*.js"
      ],
      "matches": ["https://www.linkedin.com/*"]
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
